# [1단계] 환경 설정 및 데이터셋 준비
# ---------------------------------------------------------
import os
import cv2  # OpenCV: 돌의 모양(형상)을 분석하는 도구
import numpy as np
import tensorflow as tf  # 딥러닝 엔진
import matplotlib.pyplot as plt
from tensorflow.keras.utils import image_dataset_from_directory

print("======= [1단계] 시작: 데이터셋 압축 해제 및 경로 탐색 =======")

# 1. 업로드된 zip 파일 이름 정의
ZIP_FILE = 'KNU_PoC_V2.zip'

# 2. 파일이 있는지 확인하고 압축 풀기
if os.path.exists(ZIP_FILE):
    print(f"[INFO] '{ZIP_FILE}' 파일을 찾았습니다. 압축을 해제합니다...")
    # -q 옵션은 로그를 숨겨서 화면을 깔끔하게 합니다.
    # -o 옵션은 이미 파일이 있어도 덮어쓰기(overwrite) 합니다.
    !unzip -qo {ZIP_FILE}
    print("[INFO] 압축 해제 완료.")
else:
    # 파일이 없으면 명확한 에러 메시지를 띄우고 중단합니다.
    print(f"[오류] '{ZIP_FILE}' 파일이 Colab에 없습니다. 왼쪽 파일 탭에 업로드해주세요!")
    raise FileNotFoundError("Zip file not found.")

# 3. 폴더 경로 자동 탐색 (사용자의 압축 실수 방지용)
base_path = './KNU_PoC_V2'                 # 정상적인 경로
nested_path = './KNU_PoC_V2/KNU_PoC_V2'    # 폴더 안에 폴더가 또 있는 경우

target_folder = 'C_Coal'  # 우리가 추가한 핵심 폴더가 있는지 확인

if os.path.exists(os.path.join(base_path, target_folder)):
    DATA_DIR = base_path
elif os.path.exists(os.path.join(nested_path, target_folder)):
    DATA_DIR = nested_path
else:
    raise ValueError("데이터 폴더 구조가 이상합니다. 'C_Coal' 폴더를 찾을 수 없습니다.")

print(f"[성공] 데이터셋 경로가 설정되었습니다: {DATA_DIR}")
print(f"[확인] 감지된 폴더 목록: {os.listdir(DATA_DIR)}")

# [2단계] 데이터셋 구축 및 증강 (Data Augmentation)
# ---------------------------------------------------------
print("\n======= [2단계] 시작: 데이터 로드 및 현장 노이즈 주입 =======")

# AI가 한 번에 공부할 이미지 크기와 개수 설정
IMAGE_SIZE = (224, 224) # MobileNetV2 모델이 가장 좋아하는 크기
BATCH_SIZE = 32         # 한 번에 32장씩 묶어서 학습

# 1. 훈련용 데이터셋 (80%)
train_ds = image_dataset_from_directory(
    DATA_DIR,
    validation_split=0.2,   # 20%는 검증용으로 떼어둠
    subset="training",      # 이건 훈련용
    seed=123,               # 결과 재현을 위한 랜덤 시드
    image_size=IMAGE_SIZE,
    batch_size=BATCH_SIZE
)

# 2. 검증용 데이터셋 (20%)
val_ds = image_dataset_from_directory(
    DATA_DIR,
    validation_split=0.2,
    subset="validation",    # 이건 검증용(모의고사)
    seed=123,
    image_size=IMAGE_SIZE,
    batch_size=BATCH_SIZE
)

# 클래스 이름 확인 (알파벳 순서로 자동 정렬됨)
class_names = train_ds.class_names
print(f"\n[INFO] 분류할 클래스(3종): {class_names}")
# 예상 출력: ['A_Grade_Quartz', 'C_Coal', 'C_Grade_Pyrite']

# 3. [핵심 기술] 데이터 증강 (Data Augmentation) 레이어 정의
# 이 부분이 '현장 노이즈'를 극복하게 해주는 비밀 무기입니다.
data_augmentation = tf.keras.Sequential([
    # 돌이 뒤집혀 있거나 돌아가 있어도 알아보게 함
    tf.keras.layers.RandomFlip('horizontal_and_vertical'),
    tf.keras.layers.RandomRotation(0.2),
    # 현장의 조명이 어둡거나 밝아도 알아보게 함
    tf.keras.layers.RandomBrightness(0.2),
    # 비가 오거나 흐려서 흐릿해져도 알아보게 함
    tf.keras.layers.RandomContrast(0.2)
])

# 4. 학습 속도 최적화 (데이터를 미리 메모리에 올려둠)
AUTOTUNE = tf.data.AUTOTUNE
train_ds = train_ds.cache().shuffle(1000).prefetch(buffer_size=AUTOTUNE)
val_ds = val_ds.cache().prefetch(buffer_size=AUTOTUNE)

print("======= [2단계] 완료: 학습 데이터 준비 끝 =======")

# [3단계] AI 모델 설계
# ---------------------------------------------------------
print("\n======= [3단계] 시작: 3-Class 분류 모델 설계 =======")

# 1. 사전 학습된 모델(MobileNetV2) 가져오기
base_model = tf.keras.applications.MobileNetV2(
    input_shape=IMAGE_SIZE + (3,),
    include_top=False,  # 원래의 분류기(뇌)는 떼어내고 '눈'만 가져옴
    weights='imagenet'  # 이미 수백만 장의 이미지로 훈련된 지식
)
base_model.trainable = False # 가져온 '눈'은 수정하지 않고 그대로 씀 (동결)

# 2. 우리만의 'Re-Stone Sorter V2' 모델 조립
model = tf.keras.Sequential([
    tf.keras.layers.Input(shape=IMAGE_SIZE + (3,)),
    data_augmentation,  # 아까 만든 '노이즈 주입기'를 맨 앞에 장착

    # 이미지 픽셀값을 -1 ~ 1 사이로 맞춰줌 (MobileNetV2 규칙)
    tf.keras.layers.Rescaling(1./127.5, offset=-1),

    base_model, # 전문가의 눈 (특징 추출)

    # 추출된 특징을 압축
    tf.keras.layers.GlobalAveragePooling2D(),

    # 과적합(암기) 방지를 위해 30%의 뉴런을 끄면서 학습
    tf.keras.layers.Dropout(0.3),

    # [중요] 최종 출력층: 3개의 확률을 뱉어냄 (Softmax 사용)
    # 0: Quartz, 1: Coal, 2: Pyrite
    tf.keras.layers.Dense(3, activation='softmax')
])

# 3. 모델 컴파일 (학습 방법 설정)
model.compile(
    optimizer='adam', # 가장 성능 좋은 최적화 도구
    loss='sparse_categorical_crossentropy', # 3개 이상 분류할 때 쓰는 손실함수
    metrics=['accuracy'] # 정확도를 기준으로 평가
)

model.summary() # 모델 구조 요약 출력
print("======= [3단계] 완료: 모델 설계 끝 =======")

# [4단계] 모델 학습
# ---------------------------------------------------------
print("\n======= [4단계] 시작: 모델 학습 (GPU 가속 권장) =======")

# 학습 반복 횟수 (Epochs)
# 시간이 없다면 10, 여유가 있다면 20으로 설정하세요.
EPOCHS = 20

# 학습 시작!
history = model.fit(
    train_ds,
    epochs=EPOCHS,
    validation_data=val_ds
)

print("======= [4단계] 완료: AI 학습 종료 =======")

# (선택사항) 학습 결과 그래프 그리기
acc = history.history['accuracy']
val_acc = history.history['val_accuracy']
plt.figure(figsize=(8, 4))
plt.plot(acc, label='Training Accuracy')
plt.plot(val_acc, label='Validation Accuracy')
plt.title('Training and Validation Accuracy')
plt.legend()
plt.show()
print(f"[최종 성능] 검증 정확도: {val_acc[-1]*100:.2f}%")

# [5단계] 하이브리드 판별 시연 (형상 + 성분)
# ---------------------------------------------------------
print("\n======= [5단계] 시작: Re-Stone Sorter V2 최종 시연 =======")

# --- 1. OpenCV 형상 분석 함수 (납작한 돌 걸러내기) ---
def analyze_shape_opencv(img_tensor):
    # 텐서 이미지를 OpenCV용(numpy)으로 변환
    img_np = img_tensor.numpy().astype("uint8")

    # 흑백 변환 후 이진화 (돌과 배경 분리)
    gray = cv2.cvtColor(img_np, cv2.COLOR_RGB2GRAY)
    _, thresh = cv2.threshold(gray, 0, 255, cv2.THRESH_BINARY + cv2.THRESH_OTSU)

    # 윤곽선(테두리) 찾기
    contours, _ = cv2.findContours(thresh, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)

    if not contours: return "Unknown", 0.0

    # 가장 큰 덩어리(돌) 선택
    largest_contour = max(contours, key=cv2.contourArea)

    # 최소 외접 직사각형을 그려서 가로/세로 비율 계산
    rect = cv2.minAreaRect(largest_contour)
    (center), (w, h), angle = rect

    if h == 0 or w == 0: return "Error", 0.0

    # 긴 변과 짧은 변 구분
    short = min(w, h)
    long_side = max(w, h)
    ratio = long_side / short # 장축/단축 비율

    # 비율이 3배가 넘으면 '납작한 돌(불량)'
    if ratio > 3.0:
        return "Bad", ratio
    else:
        return "Good", ratio

# --- 2. 테스트용 이미지 하나 뽑아서 시연 ---
# 검증 데이터셋에서 랜덤으로 1장 가져오기
for images, labels in val_ds.take(1):
    sample_img = images[0]
    break

# (A) 물리적 형상 분석 실행
shape_status, ratio = analyze_shape_opencv(sample_img)

# (B) 화학적 성분 분석 실행 (AI 예측)
img_batch = tf.expand_dims(sample_img, 0)
preds = model.predict(img_batch)
pred_idx = np.argmax(preds[0])   # 가장 높은 확률의 인덱스
confidence = np.max(preds[0])    # 그 확률(확신도)
pred_label_name = class_names[pred_idx] # 이름 (Quartz/Coal/Pyrite)

# (C) 하이브리드 최종 판정 로직
final_msg = ""
msg_color = 'black'

if shape_status == "Bad":
    # 1차 필터: 모양이 나쁘면 성분이 좋아도 탈락!
    final_msg = f"⛔ [기각] 입형 불량 (납작한 돌)\n(비율 1:{ratio:.1f})"
    msg_color = 'orange'
else:
    # 2차 필터: 모양 통과 시 성분 확인
    if pred_label_name == 'A_Grade_Quartz':
        final_msg = f"✅ [최종 합격] A급 고순도 경석\n(성분확신도: {confidence*100:.1f}%)"
        msg_color = 'green'
    elif pred_label_name == 'C_Coal':
        final_msg = f"⛔ [기각] 미연소 탄소(Coal) 오염\n(강도 저하 우려)"
        msg_color = 'red'
    else: # Pyrite
        final_msg = f"⛔ [위험] 황철석(Pyrite) 오염\n(산성배수 유발)"
        msg_color = 'red'

# --- 결과 시각화 ---
plt.figure(figsize=(6, 6))
plt.imshow(sample_img.numpy().astype("uint8"))
plt.axis("off")
plt.title(final_msg, color=msg_color, fontsize=14, fontweight='bold')
plt.show()

# 텍스트 로그 출력
print("\n" + "="*40)
print(f"[시스템 최종 판정 결과 로그]")
print(f"1. 형상 분석 (물리) : {shape_status} (비율 1 : {ratio:.2f})")
print(f"2. 성분 분석 (화학) : {pred_label_name} (확신도 {confidence*100:.2f}%)")
print(f"3. 최종 처리 명령   : {final_msg.splitlines()[0]}")
print("="*40)
