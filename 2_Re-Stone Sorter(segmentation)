import os
import glob

print("🎬 영상 처리를 다시 시작합니다 (설정 업그레이드)...")

VIDEO_NAME = "test_video.mp4"

if not os.path.exists(VIDEO_NAME):
    print(f"❌ 오류: '{VIDEO_NAME}' 파일을 찾을 수 없습니다.")
else:
    # 추론 및 영상 저장
    results = model.predict(
        source=VIDEO_NAME,
        save=True,

        # ★★★ [시각화 업그레이드 설정] ★★★
        retina_masks=True,  # 고해상도 마스크 (경계선 깔끔하게)
        show_boxes=False,   # 네모 박스는 끄기 (모양만 집중)

        show_labels=True,   # [중요] 이름표(Quartz/Pyrite) 표시 켜기!
        show_conf=True,     # [중요] 확률(%) 표시 켜기!

        line_width=2,       # 선 두께를 키워야 글씨도 커집니다! (1 -> 2 or 3)
        opacity=0.3,        # 색칠 투명도 (0.0~1.0). 낮을수록 투명해짐. (0.3 추천)

        conf=0.4,           # 확신도 40% 이상인 것만 표시
        iou=0.5,            # 겹친 것 제거
        stream=True
    )

    for r in results: pass

    print("\n✅ 영상 생성 완료!")

    # 저장된 파일 찾기
    predict_dirs = sorted(glob.glob('runs/segment/predict*'), key=os.path.getmtime)
    if predict_dirs:
        latest_dir = predict_dirs[-1]
        video_files = glob.glob(f'{latest_dir}/*.avi') + glob.glob(f'{latest_dir}/*.mp4')
        if video_files:
            print(f"\n📂 [결과물]: {video_files[0]}")
            print(f"👉 다운로드해서 확인해보세요!")
        else:
            print("⚠️ 영상 파일 생성 실패.")
    else:
        print("⚠️ runs 폴더 없음.")
