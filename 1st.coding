# [1단계] (수정) 압축 해제 및 '경로 진단'

print("======= [1단계] 환경 설정 및 압축 해제 시작 =======")

import os
import tensorflow as tf
from tensorflow.keras.utils import image_dataset_from_directory
import matplotlib.pyplot as plt

# 1. zip 파일 존재 확인 및 압축 해제
if os.path.exists('KNU_PoC_Upload.zip'):
    !unzip -q KNU_PoC_Upload.zip
    print("[INFO] 'KNU_PoC_Upload.zip' 압축 해제 완료.")
else:
    print("[오류] 'KNU_PoC_Upload.zip' 파일이 Colab 세션에 없습니다!")
    print("       왼쪽 '파일' 탐색기에 zip 파일을 먼저 업로드해주세요.")
    # zip 파일이 없으면 더 이상 진행할 수 없으므로 중단
    raise FileNotFoundError("'KNU_PoC_Upload.zip' not found in Colab session.")

# 2. (핵심) '이중 폴더' 문제 자동 경로 탐색 및 진단
print("\n[INFO] AI가 학습할 데이터 폴더 경로를 자동으로 탐색합니다...")

path_option_1 = './KNU_PoC_Upload'                      # 일반 경로
path_option_2 = './KNU_PoC_Upload/KNU_PoC_Upload'       # 이중 폴더 경로
target_folder = 'A_Grade_Quartz'                      # 우리가 찾는 폴더

DATA_DIR = None  # 최종 데이터 경로

if os.path.exists(os.path.join(path_option_1, target_folder)):
    DATA_DIR = path_option_1
    print(f"[성공] 데이터 경로를 찾았습니다: {DATA_DIR}")

elif os.path.exists(os.path.join(path_option_2, target_folder)):
    DATA_DIR = path_option_2
    print(f"[성공] '이중 폴더' 경로를 자동으로 감지했습니다: {DATA_DIR}")

else:
    print(f"[오류] {path_option_1} 또는 {path_option_2} 경로에서")
    print(f"       '{target_folder}' 폴더를 찾을 수 없습니다.")
    print("       zip 파일의 압축 구조를 다시 확인해주세요.")
    # 데이터 폴더를 못 찾으면 중단
    raise FileNotFoundError("Could not auto-detect the data directory.")

print("======= [1단계] 완료: 경로 탐색 성공. [2단계]를 실행하세요. =======")

from google.colab import drive
drive.mount('/content/drive')

# [2단계] 데이터 전처리 및 학습 데이터셋 구축

print("\n======= [2단계] 데이터 전처리 및 학습 데이터셋 구축 시작 =======")

# --- [1단계]에서 DATA_DIR 변수를 정상적으로 찾았는지 재확인 ---
if DATA_DIR is None:
    print("[오류] [1단계]가 정상적으로 실행되지 않았습니다.")
    print("       [1단계]의 DATA_DIR 경로 탐색을 먼저 성공시켜주세요.")
    raise ValueError("DATA_DIR is not set. Run Step 1 first.")


# 1. 하이퍼파라미터 설정
IMAGE_SIZE = (160, 160)
BATCH_SIZE = 32
VALIDATION_SPLIT = 0.2

# 2. 훈련 데이터셋 생성 (80%)
#    DATA_DIR 변수에 [1단계]에서 찾은 '올바른' 경로가 들어감
train_dataset = image_dataset_from_directory(
    DATA_DIR,
    validation_split=VALIDATION_SPLIT,
    subset="training",
    seed=123,
    image_size=IMAGE_SIZE,
    batch_size=BATCH_SIZE,
    label_mode='binary'
)

# 3. 검증 데이터셋 생성 (20%)
validation_dataset = image_dataset_from_directory(
    DATA_DIR,
    validation_split=VALIDATION_SPLIT,
    subset="validation",
    seed=123,
    image_size=IMAGE_SIZE,
    batch_size=BATCH_SIZE,
    label_mode='binary'
)

# 4. 클래스 이름 확인
class_names = train_dataset.class_names
print(f"\n[INFO] 클래스 이름: {class_names}")
print(f"  -> {class_names[0]} = 0 (A급)")
print(f"  -> {class_names[1]} = 1 (C급)")

# 5. 데이터 증강(Augmentation) 레이어 준비
data_augmentation = tf.keras.Sequential([
    tf.keras.layers.RandomFlip('horizontal'),
    tf.keras.layers.RandomRotation(0.2),
])

# 6. 학습 성능 최적화
AUTOTUNE = tf.data.AUTOTUNE
train_dataset = train_dataset.cache().prefetch(buffer_size=AUTOTUNE)
validation_dataset = validation_dataset.cache().prefetch(buffer_size=AUTOTUNE)

print("======= [2단계] 완료: 훈련/검증 데이터셋 준비 완료 =======")

# [3단계] AI 모델(CNN) 구축 (Transfer Learning)

print("\n======= [3단계] AI 모델 구축 시작 =======")

# 1. 전이 학습을 위한 '베이스 모델' 로드 (MobileNetV2)
base_model = tf.keras.applications.MobileNetV2(
    input_shape=IMAGE_SIZE + (3,),
    include_top=False,
    weights='imagenet'
)

# 2. 베이스 모델의 '눈' 부분은 '동결'
base_model.trainable = False
print("[INFO] MobileNetV2 베이스 모델 로드 및 동결 완료.")

# 3. KNU-ReM PoC 모델 구축
model = tf.keras.Sequential([
    tf.keras.layers.Input(shape=IMAGE_SIZE + (3,)),
    data_augmentation,
    tf.keras.layers.Rescaling(1./127.5, offset=-1),
    base_model,
    tf.keras.layers.GlobalAveragePooling2D(),
    tf.keras.layers.Dropout(0.2),
    tf.keras.layers.Dense(1, activation='sigmoid') # A급(0) or C급(1)
])

# 4. 모델 컴파일
model.compile(
    optimizer='adam',
    loss='binary_crossentropy',
    metrics=['accuracy']
)

# 5. 모델 구조 요약 확인
print("\n[INFO] KNU-ReM PoC 모델 구조:")
model.summary()

print("======= [3단계] 완료: AI 모델 구축 성공 =======")

# [4단계] 모델 학습(훈련)

print("\n======= [4단계] 모델 학습 시작 =======")

EPOCHS = 15  # 15번 반복 학습

history = model.fit(
    train_dataset,
    epochs=EPOCHS,
    validation_data=validation_dataset
)

print("======= [4단계] 완료: 모델 학습 성공 =======")

# [5단계] 학습 결과 시각화 및 평가

print("\n======= [5단계] 학습 결과 시각화 시작 =======")

acc = history.history['accuracy']
val_acc = history.history['val_accuracy']
loss = history.history['loss']
val_loss = history.history['val_loss']

plt.figure(figsize=(12, 5))

# 1. 정확도(Accuracy) 그래프
plt.subplot(1, 2, 1)
plt.plot(acc, label='Training Accuracy')
plt.plot(val_acc, label='Validation Accuracy')
plt.legend(loc='lower right')
plt.title('Training and Validation Accuracy')
plt.xlabel('Epoch')
plt.ylabel('Accuracy')

# 2. 손실(Loss) 그래프
plt.subplot(1, 2, 2)
plt.plot(loss, label='Training Loss')
plt.plot(val_loss, label='Validation Loss')
plt.legend(loc='upper right')
plt.title('Training and Validation Loss')
plt.xlabel('Epoch')
plt.ylabel('Loss')

plt.suptitle("KNU-ReM PoC 모델 학습 결과", fontsize=16)
plt.show()

print(f"\n[결과] 최종 검증 정확도: {val_acc[-1]*100:.2f}%")
print("======= [5단계] 완료 =======")

# [6단계] 새로운 이미지로 실시간 예측 (프로토타입 시연)
import numpy as np

print("\n======= [6단계] 프로토타입 시연 시작 =======")

# 1. 검증 데이터셋에서 이미지 1개(배치) 가져오기
for images, labels in validation_dataset.take(1):
    image_batch = images
    label_batch = labels

# 2. 첫 번째 이미지로 예측 수행
sample_image = image_batch[0:1]
prediction = model.predict(sample_image)

# 3. 예측 결과 해석
predicted_class_index = (prediction[0][0] > 0.5).astype(int)
predicted_class_name = class_names[predicted_class_index]
true_class_name = class_names[int(label_batch[0][0])]

# 4. 결과 출력
plt.figure(figsize=(5, 5))
plt.imshow(sample_image[0].numpy().astype("uint8"))
plt.title(f"AI 예측: {predicted_class_name} (A급=0, C급=1)\n실제 정답: {true_class_name}")
plt.axis("off")
plt.show()

print(f"[INFO] AI의 예측 값 (Raw): {prediction[0][0]:.4f}")
print(f"       -> AI의 판단: '{predicted_class_name}'")
print(f"       -> 실제 정답: '{true_class_name}'")

print("======= [6단계] 완료 =======")
